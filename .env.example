# Copy to .env on the server and fill in. Never commit the filled file.
# Database password for the compose Postgres (any long random string).
POSTGRES_PASSWORD=
# Domain for HTTPS through caddy, or :80 for plain HTTP by IP address.
SITE_ADDRESS=
# replay (recorded model answers) or live.
COACHCOVER_MODEL_MODE=replay
# Judge runs per client address per hour.
COACHCOVER_JUDGE_RUNS_PER_HOUR=6
# Local port for the API (bound to 127.0.0.1).
API_PORT=8088
# VULTR_INFERENCE_API_KEY is never stored here: pass it from the shell environment for live mode.
